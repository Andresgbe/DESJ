# Copia como .env (no se sube a git). Supabase → Project Settings → API Keys.
DESJ_SUPABASE_URL=https://ffdddvzpoczaljcqlwhc.supabase.co
# Clave SECRETA de servidor (sb_secret_...). Solo vive en este computador; nunca en la app.
DESJ_SUPABASE_SECRET_KEY=
# Opcionales
# DESJ_WORKER_MODEL=sonnet
# DESJ_WORKER_MAX_PER_HOUR=30
# DESJ_WORKER_MAX_PER_DAY=150
# Mensajes de más de 4000 caracteres se leen por partes desde un archivo, hasta este máximo:
# DESJ_WORKER_MAX_LONG_CHARS=60000
# Google (Drive, Gmail, Calendar): mismos valores que los secretos de Supabase.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXUS (la plataforma de Andrés): id de la ÚNICA cuenta de DESJ que puede manejarla (Supabase → Authentication → Users).
# El MCP de NEXUS usa su propio login en career-os/mcp-server/.env. Ruta opcional si career-os no está al lado de DESJ.
# DESJ_NEXUS_USER_ID=…
# DESJ_NEXUS_MCP=C:/dev/clients/career-os/mcp-server/index.js
