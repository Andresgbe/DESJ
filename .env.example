# Copia este archivo como .env y llena los valores (Supabase → Project Settings → API).
# Ambos son públicos por diseño: la seguridad la da RLS. La API key de Claude NO va aquí,
# va en Supabase → Edge Functions → Secrets como ANTHROPIC_API_KEY.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ID de cliente OAuth de Google (público). El secreto va solo en Supabase (GOOGLE_CLIENT_SECRET) y en desj-worker/.env.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
